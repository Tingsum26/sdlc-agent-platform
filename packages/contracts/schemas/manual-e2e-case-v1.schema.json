{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sdlc/schemas/manual-e2e-case-v1.schema.json",
  "title": "Manual E2E Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "caseId", "title", "result"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "caseId": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "result": { "enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN"] },
    "actorRole": { "type": "string", "minLength": 1 },
    "executedAt": { "type": "string", "format": "date-time" },
    "buildFingerprint": { "type": "string", "minLength": 1 },
    "actualResult": { "type": "string", "minLength": 1 },
    "evidenceOrWaiver": { "type": "string", "minLength": 1 }
  },
  "allOf": [{
    "if": { "properties": { "result": { "enum": ["PASS", "FAIL", "BLOCKED"] } }, "required": ["result"] },
    "then": {
      "properties": {
        "actorRole": true,
        "executedAt": true,
        "buildFingerprint": true,
        "actualResult": true,
        "evidenceOrWaiver": true
      },
      "required": ["actorRole", "executedAt", "buildFingerprint", "actualResult", "evidenceOrWaiver"]
    }
  }]
}
