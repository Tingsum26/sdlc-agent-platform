{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sdlc/schemas/artifact-v1.schema.json",
  "title": "Structured Artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactId", "taskId", "type", "version", "contentHash", "sections", "createdBy", "createdAt"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "artifactId": { "type": "string", "minLength": 3, "maxLength": 64 },
    "taskId": { "type": "string", "minLength": 3, "maxLength": 64 },
    "type": { "enum": ["REQUIREMENT_REPORT", "DESIGN_REPORT", "TEST_REPORT", "MANUAL_E2E_REPORT", "PR_REVIEW_REPORT", "DELIVERY_REPORT"] },
    "version": { "type": "integer", "minimum": 1 },
    "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "title", "body"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 160 },
          "body": { "type": "string", "maxLength": 100000 }
        }
      }
    },
    "createdBy": { "type": "string", "minLength": 1, "maxLength": 128 },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
