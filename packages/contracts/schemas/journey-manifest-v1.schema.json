{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/journey-manifest-v1.schema.json",
  "title": "Journey manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "journeyId", "domainId", "version", "repositories", "screens", "httpEdges", "releasePolicy", "featureFlag", "e2eOwners"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "journeyId": { "$ref": "#/$defs/id" },
    "domainId": { "$ref": "#/$defs/id" },
    "version": { "type": "integer", "minimum": 1 },
    "repositories": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "$ref": "#/$defs/repository" } },
    "screens": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/screen" } },
    "httpEdges": { "type": "array", "maxItems": 5000, "items": { "$ref": "#/$defs/httpEdge" } },
    "releasePolicy": { "$ref": "#/$defs/releasePolicy" },
    "featureFlag": { "$ref": "#/$defs/featureFlag" },
    "e2eOwners": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "$ref": "#/$defs/e2eOwner" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,79}$" },
    "ref": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "repository": {
      "type": "object", "additionalProperties": false, "required": ["alias", "role", "ref"],
      "properties": { "alias": { "$ref": "#/$defs/id" }, "role": { "enum": ["API", "WEB", "IOS", "ANDROID", "SUPPORTING"] }, "ref": { "$ref": "#/$defs/ref" } }
    },
    "screen": {
      "type": "object", "additionalProperties": false, "required": ["screenId", "client", "repositoryAlias"],
      "properties": { "screenId": { "$ref": "#/$defs/id" }, "client": { "enum": ["WEB", "IOS", "ANDROID"] }, "repositoryAlias": { "$ref": "#/$defs/id" } }
    },
    "provenance": {
      "type": "object", "additionalProperties": false, "required": ["source", "ref", "evidenceId"],
      "properties": { "source": { "$ref": "#/$defs/id" }, "ref": { "$ref": "#/$defs/ref" }, "evidenceId": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]{2,79}$" } }
    },
    "httpEdge": {
      "type": "object", "additionalProperties": false,
      "required": ["edgeId", "caller", "apiRepositoryAlias", "method", "normalizedPath", "requestSchemaRef", "responseSchemaRef", "commonHeaderRule", "authenticationClass", "compatibility", "provenance"],
      "properties": {
        "edgeId": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]{2,79}$" },
        "caller": { "$ref": "#/$defs/id" },
        "apiRepositoryAlias": { "$ref": "#/$defs/id" },
        "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
        "normalizedPath": { "type": "string", "pattern": "^/", "maxLength": 300 },
        "requestSchemaRef": { "type": "string", "minLength": 1, "maxLength": 300 },
        "responseSchemaRef": { "type": "string", "minLength": 1, "maxLength": 300 },
        "commonHeaderRule": { "type": "string", "minLength": 1, "maxLength": 120 },
        "authenticationClass": { "type": "string", "minLength": 1, "maxLength": 80 },
        "compatibility": { "enum": ["BACKWARD_COMPATIBLE", "ADDITIVE_WITH_FLAG", "BREAKING_REJECTED"] },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "releasePolicy": {
      "type": "object", "additionalProperties": false, "required": ["webApiFirst", "nativeReleaseTrain", "compatibilityWindowDays", "rollbackRule"],
      "properties": { "webApiFirst": { "type": "boolean" }, "nativeReleaseTrain": { "type": "string", "minLength": 1, "maxLength": 80 }, "compatibilityWindowDays": { "type": "integer", "minimum": 1, "maximum": 730 }, "rollbackRule": { "type": "string", "minLength": 1, "maxLength": 300 } }
    },
    "featureFlag": {
      "type": "object", "additionalProperties": false, "required": ["required", "provider", "ownerRole"],
      "properties": { "required": { "type": "boolean" }, "provider": { "type": "string", "minLength": 1, "maxLength": 80 }, "ownerRole": { "type": "string", "minLength": 1, "maxLength": 80 } }
    },
    "e2eOwner": {
      "type": "object", "additionalProperties": false, "required": ["scenario", "ownerRole"],
      "properties": { "scenario": { "$ref": "#/$defs/id" }, "ownerRole": { "type": "string", "minLength": 1, "maxLength": 80 } }
    }
  }
}
