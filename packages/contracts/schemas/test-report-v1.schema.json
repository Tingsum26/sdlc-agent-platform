{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sdlc/schemas/test-report-v1.schema.json",
  "title": "Test Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "buildFingerprint", "automatedEvidence", "generatedManualCases"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "buildFingerprint": { "type": "string", "minLength": 1 },
    "automatedEvidence": { "type": "array", "items": { "$ref": "#/$defs/testEvidence" } },
    "generatedManualCases": { "type": "array", "items": { "$ref": "#/$defs/testEvidence" } }
  },
  "$defs": {
    "testEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "evidence"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "status": { "enum": ["PASSED", "FAILED", "NOT_RUN"] },
        "evidence": { "type": "string" }
      }
    }
  }
}
