{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/integration-diagnostic-v1.schema.json",
  "title": "Integration diagnostic",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "provider", "status", "observedAt", "source", "safeDetail"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "provider": { "enum": ["JIRA", "CONFLUENCE", "GHES", "JENKINS", "SPLUNK"] },
    "status": { "enum": ["SIMULATED_PASS", "CONTRACT_PASS", "INTERNAL_VALIDATION_REQUIRED", "BLOCKED"] },
    "observedAt": { "type": "string", "format": "date-time" },
    "source": { "type": "string", "minLength": 1, "maxLength": 80 },
    "safeDetail": { "type": "string", "minLength": 1, "maxLength": 500 }
  }
}
