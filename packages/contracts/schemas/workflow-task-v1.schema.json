{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sdlc/schemas/workflow-task-v1.schema.json",
  "title": "Workflow Task v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "type", "status", "scope", "version", "createdAt", "updatedAt"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "taskId": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{2,63}$" },
    "type": {
      "enum": [
        "REQUIREMENT_ANALYSIS",
        "DESIGN",
        "IMPLEMENTATION",
        "TEST_GENERATION",
        "PR_REVIEW",
        "MANUAL_E2E",
        "DELIVERY_COORDINATION",
        "ONBOARDING_SYNC"
      ]
    },
    "status": {
      "enum": [
        "CREATED",
        "WAITING_FOR_LOCAL_COPILOT",
        "LOCAL_COPILOT_RUNNING",
        "WAITING_FOR_USER_CONFIRMATION",
        "WAITING_FOR_APPROVAL",
        "WAITING_FOR_CI",
        "WAITING_FOR_MANUAL_E2E",
        "BLOCKED",
        "COMPLETED",
        "CANCELLED"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ticketId", "repositoryAlias", "targetCommit"],
      "properties": {
        "ticketId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "repositoryAlias": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{1,63}$" },
        "targetCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      }
    },
    "assigneeId": { "type": ["string", "null"], "maxLength": 128 },
    "leaseExpiresAt": { "type": ["string", "null"], "format": "date-time" },
    "version": { "type": "integer", "minimum": 0 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
