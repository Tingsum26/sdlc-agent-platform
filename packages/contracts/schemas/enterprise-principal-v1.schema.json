{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/enterprise-principal-v1.schema.json",
  "title": "Enterprise principal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "principalId", "employeeId", "displayLabel", "source"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "principalId": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]{2,63}$" },
    "employeeId": { "type": "string", "pattern": "^[A-Z0-9_-]{2,63}$" },
    "displayLabel": { "type": "string", "minLength": 1, "maxLength": 120 },
    "maskedEmail": { "type": "string", "pattern": "^[^@]*\\*+[^@]*@example\\.invalid$", "maxLength": 160 },
    "source": { "enum": ["GITHUB_ENTERPRISE", "ADMIN_BINDING", "SSO"] },
    "githubLogin": { "type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$" }
  }
}
