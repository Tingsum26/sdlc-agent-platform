{
  "schemaVersion": "1.0",
  "collections": [
    { "name": "workflowTasks", "indexes": [
      { "name": "ux_workflow_idempotency", "keys": { "idempotencyKey": 1 }, "unique": true },
      { "name": "ix_workflow_status_updated", "keys": { "status": 1, "updatedAt": -1 }, "unique": false }
    ] },
    { "name": "auditEvents", "indexes": [
      { "name": "ux_audit_task_sequence", "keys": { "taskId": 1, "sequence": 1 }, "unique": true }
    ] },
    { "name": "artifacts", "indexes": [
      { "name": "ux_artifact_version", "keys": { "artifactId": 1, "version": 1 }, "unique": true },
      { "name": "ix_artifact_task", "keys": { "taskId": 1, "createdAt": -1 }, "unique": false }
    ] },
    { "name": "webhookDeliveries", "indexes": [
      { "name": "ux_webhook_delivery", "keys": { "deliveryId": 1 }, "unique": true }
    ] },
    { "name": "podRosters", "indexes": [
      { "name": "ux_pod_journey", "keys": { "journeyId": 1 }, "unique": true }
    ] },
    { "name": "taskAssignments", "indexes": [
      { "name": "ux_assignment_ticket", "keys": { "ticketId": 1 }, "unique": true },
      { "name": "ix_assignment_principal", "keys": { "principalId": 1, "assignedAt": -1 }, "unique": false }
    ] }
  ]
}
