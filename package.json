{
  "name": "@sdlc/root",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "e2e:public-mvp": "playwright test e2e/public-mvp.spec.ts",
    "e2e:m1": "playwright test e2e/m1-identity-pod.spec.ts",
    "e2e:m2": "playwright test e2e/m2-three-level-workflow.spec.ts",
    "e2e:m3": "playwright test e2e/m3-enterprise-adapters.spec.ts",
    "e2e:m4": "playwright test e2e/m4-journey-onboarding.spec.ts",
    "e2e:m7": "playwright test e2e/m7-end-to-end.spec.ts",
    "verify:internal-todos": "node scripts/validate-internal-todos.mjs",
    "verify:workflow-security": "node --test scripts/tests/githubWorkflows.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1"
  },
  "pnpm": {
    "overrides": {
      "ajv": "8.18.0"
    }
  }
}
